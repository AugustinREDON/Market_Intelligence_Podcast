# Google Drive desktop-sync location for incoming podcast scripts
DRIVE_SCRIPTS_DIR=/path/to/Google Drive/Market Intelligence Podcast/Scripts

# Google Drive API folder IDs
DRIVE_MAIN_FOLDER_ID=your_main_folder_id
DRIVE_EPISODES_FOLDER_ID=your_episodes_folder_id

# Local voice reference files used by Chatterbox TTS
HOST_A_VOICE_PATH=voices/host_a.wav
HOST_B_VOICE_PATH=voices/host_b.wav